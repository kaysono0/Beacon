# Copy to local.agora.env and fill in your own values, then run the real macOS gates.
#   cp local.agora.env.example local.agora.env
# local.agora.env is git-ignored. Never commit real credentials.

# Path to the Agora macOS SDK root that contains AgoraRtcKit.framework
# (or AgoraRtcKit.xcframework). Download it from Agora and accept their terms.
AGORA_MAC_SDK_ROOT=/absolute/path/to/agora-macos-sdk

# Your Agora project credentials. Used to mint RTC tokens at test time.
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERT=your-agora-app-cert

# Shared auth token between the harness, the server, and agents.
BEACON_AUTH_TOKEN=local-test-token

# --- Optional ---------------------------------------------------------------

# Pre-generated RTC token for cases that pass an explicit token instead of
# letting the server mint one.
# AGORA_RTC_TOKEN=

# Token lifetime in seconds for server-side token generation.
# AGORA_TOKEN_TTL_SECONDS=3600

# Per-uid token map used by Python-native cases (JSON object).
# BEACON_AGORA_RTC_TOKEN_MAP={"1001":"...","1002":"..."}

# Local server port for the Mac console.
# BEACON_CONSOLE_SERVER_PORT=8000

# Registered agent mode for the local console server: auto | mock | real.
# BEACON_CONSOLE_AGENT_MODE=auto

# Number of autorun rounds in the app-driven validation gate.
# BEACON_MAC_CONSOLE_AGORA_ROUNDS=2

# Restrict the app-driven validation gate to specific case ids.
# BEACON_MAC_CONSOLE_AGORA_CASE_IDS=

# Weak-network fault injection backend. The privileged backend needs root and
# an authorised test machine; leave unset otherwise.
# BEACON_NETWORK_CONDITION_BACKEND=macos_pf
# BEACON_NETWORK_CONDITION_ALLOW_PRIVILEGED=1
