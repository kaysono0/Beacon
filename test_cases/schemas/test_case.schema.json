{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_case.schema.json",
  "title": "BeaconTestCase",
  "type": "object",
  "required": ["case_id", "name", "platform", "steps"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["common", "mac", "ios", "android"] },
    "suite": { "type": "string", "minLength": 1 },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "covered_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenario_family": { "type": "string", "minLength": 1 },
    "implementation_status": {
      "type": "string",
      "enum": ["runnable", "runnable_or_partial", "designed_but_blocked"]
    },
    "blocked_category": { "type": "string", "minLength": 1 },
    "blocked_reason": { "type": "string", "minLength": 1 },
    "runnable_prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "owner_layer": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "packet"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "assertions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "target"],
                  "properties": {
                    "type": { "const": "event_exists" },
                    "target": { "$ref": "packet.schema.json#/$defs/target" },
                    "payload_filters": { "type": "object" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "target", "value"],
                  "properties": {
                    "type": { "const": "metric_gt" },
                    "target": { "$ref": "packet.schema.json#/$defs/target" },
                    "value": { "type": "number" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "target"],
                  "properties": {
                    "type": { "const": "artifact_exists" },
                    "target": { "$ref": "packet.schema.json#/$defs/target" },
                    "payload_filters": { "type": "object" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "target", "value"],
                  "properties": {
                    "type": { "const": "state_equals" },
                    "target": { "$ref": "packet.schema.json#/$defs/target" },
                    "value": {},
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "value"],
                  "properties": {
                    "type": { "const": "error_code" },
                    "value": { "type": "integer" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "value"],
                  "properties": {
                    "type": { "const": "failure_classification" },
                    "value": { "type": "object" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "module", "event"],
                  "properties": {
                    "type": { "const": "log_event_exists" },
                    "module": { "type": "string", "minLength": 1 },
                    "event": { "type": "string", "minLength": 1 },
                    "level": { "type": "string" },
                    "lease_id": { "type": "string", "minLength": 1 },
                    "op_id": { "type": "string", "minLength": 1 },
                    "start_ms": { "type": "integer", "minimum": 0 },
                    "end_ms": { "type": "integer", "minimum": 0 },
                    "where": { "type": "object" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "module", "event"],
                  "properties": {
                    "type": { "const": "log_event_absent" },
                    "module": { "type": "string", "minLength": 1 },
                    "event": { "type": "string", "minLength": 1 },
                    "level": { "type": "string" },
                    "lease_id": { "type": "string", "minLength": 1 },
                    "op_id": { "type": "string", "minLength": 1 },
                    "start_ms": { "type": "integer", "minimum": 0 },
                    "end_ms": { "type": "integer", "minimum": 0 },
                    "where": { "type": "object" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "module", "event", "value"],
                  "properties": {
                    "type": { "const": "log_error_code_equals" },
                    "module": { "type": "string", "minLength": 1 },
                    "event": { "type": "string", "minLength": 1 },
                    "level": { "type": "string" },
                    "lease_id": { "type": "string", "minLength": 1 },
                    "op_id": { "type": "string", "minLength": 1 },
                    "start_ms": { "type": "integer", "minimum": 0 },
                    "end_ms": { "type": "integer", "minimum": 0 },
                    "where": { "type": "object" },
                    "value": { "type": "integer" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "module", "event", "where"],
                  "properties": {
                    "type": { "const": "log_extra_matches" },
                    "module": { "type": "string", "minLength": 1 },
                    "event": { "type": "string", "minLength": 1 },
                    "level": { "type": "string" },
                    "lease_id": { "type": "string", "minLength": 1 },
                    "op_id": { "type": "string", "minLength": 1 },
                    "start_ms": { "type": "integer", "minimum": 0 },
                    "end_ms": { "type": "integer", "minimum": 0 },
                    "where": { "type": "object" },
                    "timeout_ms": { "type": "integer", "minimum": 1 }
                  }
                }
              ]
            }
          },
          "packet": { "$ref": "packet.schema.json" }
        }
      }
    }
  }
}
