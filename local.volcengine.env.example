# Copy to local.volcengine.env and fill in your own values, then run the real macOS gates.
#   cp local.volcengine.env.example local.volcengine.env
# local.volcengine.env is git-ignored. Never commit real credentials.

# Credential spelling: use VOLCENGINE_* only. The older VOLENGINE_RTC_* spelling
# found in some local files is legacy - rename it when you create this file.
# Readers do not fall back to the legacy spelling.

# Path to the Volcengine macOS SDK root that contains VolcEngineRTC.framework
# (and its companion frameworks/dylibs). Download it from Volcengine and accept
# their terms.
VOLCENGINE_MAC_SDK_ROOT=/absolute/path/to/volcengine-macos-sdk

# Your Volcengine RTC project credentials. Used to mint room tokens at test time.
# VOLCENGINE_RTC_ID is 24 characters, matching the SDK's APP_ID_LENGTH.
VOLCENGINE_RTC_ID=your-volcengine-rtc-app-id
VOLCENGINE_RTC_APPKEY=your-volcengine-rtc-app-key

# Shared auth token between the harness, the server, and agents.
BEACON_AUTH_TOKEN=local-test-token

# --- Optional ---------------------------------------------------------------

# Pre-generated RTC token for cases that pass an explicit token instead of
# letting the server mint one. Console-issued temporary tokens last 7 days and
# are only for local debugging; formal gates must use server-side signing.
# VOLCENGINE_RTC_TOKEN=

# Token lifetime in seconds for server-side token generation.
# VOLCENGINE_TOKEN_TTL_SECONDS=3600

# Per-room/user token map used by Python-native cases (JSON object).
# BEACON_VOLCENGINE_RTC_TOKEN_MAP={"room-1#user-1":"..."}

# Default room id / user id used by the Volcengine L1 cases.
# VOLCENGINE_RTC_ROOM_ID=
# VOLCENGINE_RTC_USER_ID=
